# Database
DATABASE_URL="mysql://user:password@host:3306/karyakelas?sslaccept=strict"

# Canonical application origin. Use https in production.
APP_URL="http://localhost:3000"

# Random secret, at least 32 bytes. Used for HMAC rate-limit keys.
AUTH_SECRET="replace-with-a-long-random-secret"

# Vercel Blob read/write token. Required for uploads.
BLOB_READ_WRITE_TOKEN=""

# Formspree endpoint for the homepage feedback form.
# Create a form at https://formspree.io, then paste the endpoint, e.g.
# https://formspree.io/f/xxxxxxxx
FORMSPREE_ENDPOINT=""

# Comma-separated host allowlist for live previews.
# Supports exact hosts and wildcard suffixes, e.g. *.vercel.app,*.netlify.app
PREVIEW_ALLOWED_HOSTS="*.vercel.app"

# First admin, used by prisma/seed.ts.
SEED_ADMIN_NAME="Admin KaryaKelas"
SEED_ADMIN_USERNAME="admin"
SEED_ADMIN_EMAIL="admin@example.com"
SEED_ADMIN_PASSWORD="replace-with-a-strong-password"

# Set true only for local/demo data. Keep false in production.
SEED_DEMO_DATA="false"
