generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "mysql"
}

enum Role {
  ADMIN
  USER
}

enum ProjectStatus {
  DRAFT
  PUBLISHED
}

enum PklStatus {
  SUBMITTED
  REVIEWED
  REVISION
}

model User {
  id           String @id @default(cuid()) @db.VarChar(30)
  fullName     String @map("full_name") @db.VarChar(80)
  username     String @unique @db.VarChar(30)
  email        String @unique @db.VarChar(254)
  passwordHash String @map("password_hash") @db.VarChar(255)
  role         Role   @default(USER)

  createdAt DateTime @default(now()) @map("created_at") @db.DateTime(3)
  updatedAt DateTime @updatedAt @map("updated_at") @db.DateTime(3)

  createdProjects    Project[]       @relation("ProjectCreator")
  projectMemberships ProjectMember[]
  sessions           Session[]
  pklSubmission      PklSubmission?

  @@index([fullName])
  @@map("users")
}

model Session {
  id         String   @id @default(cuid()) @db.VarChar(30)
  tokenHash  String   @unique @map("token_hash") @db.Char(64)
  userId     String   @map("user_id") @db.VarChar(30)
  expiresAt  DateTime @map("expires_at") @db.DateTime(3)
  createdAt  DateTime @default(now()) @map("created_at") @db.DateTime(3)
  lastUsedAt DateTime @default(now()) @map("last_used_at") @db.DateTime(3)
  ipHash     String?  @map("ip_hash") @db.Char(64)
  userAgent  String?  @map("user_agent") @db.VarChar(255)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
  @@map("sessions")
}

model AuthAttempt {
  id        BigInt   @id @default(autoincrement())
  action    String   @db.VarChar(20)
  keyHash   String   @map("key_hash") @db.Char(64)
  createdAt DateTime @default(now()) @map("created_at") @db.DateTime(3)

  @@index([action, keyHash, createdAt])
  @@index([createdAt])
  @@map("auth_attempts")
}

model Category {
  id   String @id @default(cuid()) @db.VarChar(30)
  name String @unique @db.VarChar(60)
  slug String @unique @db.VarChar(80)

  createdAt DateTime @default(now()) @map("created_at") @db.DateTime(3)
  updatedAt DateTime @updatedAt @map("updated_at") @db.DateTime(3)

  projects Project[]

  @@map("categories")
}

model Technology {
  id   String @id @default(cuid()) @db.VarChar(30)
  name String @unique @db.VarChar(60)
  slug String @unique @db.VarChar(80)

  createdAt DateTime @default(now()) @map("created_at") @db.DateTime(3)
  updatedAt DateTime @updatedAt @map("updated_at") @db.DateTime(3)

  projectTechnologies ProjectTechnology[]

  @@map("technologies")
}

model Project {
  id            String        @id @default(cuid()) @db.VarChar(30)
  slug          String        @unique @db.VarChar(160)
  title         String        @db.VarChar(160)
  summary       String        @db.VarChar(280)
  description   String        @db.Text
  thumbnailPath String?       @map("thumbnail_path") @db.VarChar(2048)
  status        ProjectStatus @default(DRAFT)
  githubUrl     String?       @map("github_url") @db.VarChar(2048)
  previewUrl    String?       @map("preview_url") @db.VarChar(2048)
  creatorId     String        @map("creator_id") @db.VarChar(30)
  categoryId    String        @map("category_id") @db.VarChar(30)
  publishedAt   DateTime?     @map("published_at") @db.DateTime(3)

  createdAt DateTime @default(now()) @map("created_at") @db.DateTime(3)
  updatedAt DateTime @updatedAt @map("updated_at") @db.DateTime(3)

  creator             User                @relation("ProjectCreator", fields: [creatorId], references: [id], onDelete: Restrict)
  category            Category            @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  members             ProjectMember[]
  images              ProjectImage[]
  projectTechnologies ProjectTechnology[]

  @@index([status])
  @@index([categoryId])
  @@index([creatorId])
  @@index([title])
  @@index([publishedAt])
  @@index([status, publishedAt])
  @@index([status, categoryId])
  @@index([status, creatorId])
  @@map("projects")
}

model ProjectMember {
  id        String   @id @default(cuid()) @db.VarChar(30)
  projectId String   @map("project_id") @db.VarChar(30)
  userId    String   @map("user_id") @db.VarChar(30)
  createdAt DateTime @default(now()) @map("created_at") @db.DateTime(3)

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([projectId, userId])
  @@index([userId])
  @@map("project_members")
}

model ProjectImage {
  id        String   @id @default(cuid()) @db.VarChar(30)
  projectId String   @map("project_id") @db.VarChar(30)
  imagePath String   @map("image_path") @db.VarChar(2048)
  caption   String?  @db.VarChar(200)
  sortOrder Int      @default(0) @map("sort_order")
  createdAt DateTime @default(now()) @map("created_at") @db.DateTime(3)

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@index([projectId, sortOrder])
  @@map("project_images")
}

model ProjectTechnology {
  projectId    String   @map("project_id") @db.VarChar(30)
  technologyId String   @map("technology_id") @db.VarChar(30)
  createdAt    DateTime @default(now()) @map("created_at") @db.DateTime(3)

  project    Project    @relation(fields: [projectId], references: [id], onDelete: Cascade)
  technology Technology @relation(fields: [technologyId], references: [id], onDelete: Restrict)

  @@id([projectId, technologyId])
  @@index([technologyId])
  @@map("project_technologies")
}

model PklSubmission {
  id         String    @id @default(cuid()) @db.VarChar(30)
  userId     String    @unique @map("user_id") @db.VarChar(30)
  title      String    @db.VarChar(160)
  company    String    @db.VarChar(120)
  summary    String    @db.Text
  reportUrl  String    @map("report_url") @db.VarChar(2048)
  status     PklStatus @default(SUBMITTED)
  reviewNote String?   @map("review_note") @db.Text
  reviewedAt DateTime? @map("reviewed_at") @db.DateTime(3)

  createdAt DateTime @default(now()) @map("created_at") @db.DateTime(3)
  updatedAt DateTime @updatedAt @map("updated_at") @db.DateTime(3)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([status, createdAt])
  @@index([createdAt])
  @@map("pkl_submissions")
}
